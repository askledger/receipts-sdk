# Code ownership — every change needs at least one owner of every touched area.
# Format: glob  @owner1 @owner2

# Default — every file has at least one reviewer.
*                                   @projectledger/maintainers

# Cryptographic core — TWO reviewers required, one must be from @crypto.
/src/crypto.ts                      @projectledger/crypto @projectledger/maintainers
/src/canonicalize.ts                @projectledger/crypto @projectledger/maintainers
/src/receipt.ts                     @projectledger/crypto @projectledger/maintainers
/src/verify.ts                      @projectledger/crypto @projectledger/maintainers
/src/chain*.ts                      @projectledger/crypto @projectledger/maintainers
/src/merkle.ts                      @projectledger/crypto @projectledger/maintainers
/src/signing-provider.ts            @projectledger/crypto @projectledger/maintainers
/src/fips.ts                        @projectledger/crypto @projectledger/maintainers
/src/hsm/**                         @projectledger/crypto @projectledger/maintainers

# Cross-language SDKs — at least one owner per language.
/python/**                          @projectledger/sdk-python
/go-sdk/**                          @projectledger/sdk-go
/rust-sdk/**                        @projectledger/sdk-rust
/java-sdk/**                        @projectledger/sdk-java

