/console/src/middleware.ts          @projectledger/security
/console/**                         @projectledger/console

# Browser extension.
/browser-extension/**               @projectledger/extension @projectledger/security

# Documentation.
/docs/operations/**                 @projectledger/sre
/docs/security/**                   @projectledger/security
