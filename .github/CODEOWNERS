# Code ownership — every change needs at least one owner of every touched area.
# Format: glob  @owner1 @owner2

# Default — every file has at least one reviewer.
*                                   @askledger/maintainers

# Cryptographic core — TWO reviewers required, one must be from @crypto.
/src/crypto.ts                      @askledger/crypto @askledger/maintainers
/src/canonicalize.ts                @askledger/crypto @askledger/maintainers
/src/receipt.ts                     @askledger/crypto @askledger/maintainers
/src/verify.ts                      @askledger/crypto @askledger/maintainers
/src/chain*.ts                      @askledger/crypto @askledger/maintainers
/src/merkle.ts                      @askledger/crypto @askledger/maintainers
/src/signing-provider.ts            @askledger/crypto @askledger/maintainers
/src/fips.ts                        @askledger/crypto @askledger/maintainers
/src/hsm/**                         @askledger/crypto @askledger/maintainers

# Cross-language SDKs — at least one owner per language.
/python/**                          @askledger/sdk-python
/go-sdk/**                          @askledger/sdk-go
/rust-sdk/**                        @askledger/sdk-rust
/java-sdk/**                        @askledger/sdk-java

# Policy templates — review by compliance + the originating regulator's owner.
/src/policy-templates/**            @askledger/compliance @askledger/maintainers

# Console — UI + RBAC.
/console/src/lib/auth.ts            @askledger/security
/console/src/lib/rbac.ts            @askledger/security
/console/src/lib/tenant-context.ts  @askledger/security
/console/src/middleware.ts          @askledger/security
/console/**                         @askledger/console

# Browser extension.
/browser-extension/**               @askledger/extension @askledger/security

# Documentation.
/docs/operations/**                 @askledger/sre
/docs/security/**                   @askledger/security
/docs/strategy/**                   @askledger/maintainers

# CI / supply chain.
/.github/**                         @askledger/sre
/tools/**                           @askledger/sre
